NODE_ENV=development
PORT=4000
APP_NAME=CloudShield API
JWT_ACCESS_SECRET=change_me_access_secret_which_is_at_least_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_which_is_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudshield
REDIS_URL=redis://localhost:6379
AI_ENGINE_URL=http://localhost:8000
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=1024
CORS_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true
DEFAULT_TENANT_SLUG=default-org
